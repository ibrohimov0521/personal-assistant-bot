BOT_TOKEN=telegram_bot_tokeningiz

# Bo'sh qoldirilsa hamma foydalana oladi.
# Faqat ayrim odamlarga ruxsat berish uchun: 6388458077,123456789
ALLOWED_USER_IDS=
# Admin panel faqat shu ID'larga ko'rinadi. Bo'sh qoldirmang.
ADMIN_USER_IDS=

TIMEZONE=Asia/Tashkent
REMINDER_CHECK_SECONDS=10
PRAYER_CHECK_SECONDS=30
PRAYER_DEFAULT_CITY=Toshkent
DAILY_REPORT_CHECK_SECONDS=300
DAILY_REPORT_HOUR=21
BACKUP_CHECK_SECONDS=900
BACKUP_HOUR=3
BACKUP_KEEP_LAST=14
HEALTH_CHECK_SECONDS=300

# Mini App local server. Telegram ichida real ochilishi uchun MINI_APP_URL HTTPS bo'lishi kerak.
MINIAPP_HOST=127.0.0.1
MINIAPP_PORT=8080
MINI_APP_URL=http://127.0.0.1:8080/
MINIAPP_DEV_USER_ID=
MINIAPP_ALLOW_LOCAL_PREVIEW=0
MINIAPP_AUTH_MAX_AGE_SECONDS=2592000

# Ixtiyoriy: UZCARD/HUMO botlaridan kelgan xabarlarni avtomatik assistant botga yuborish.
# my.telegram.org dan olinadi. Bu user account session ishlatadi.
TG_API_ID=
TG_API_HASH=
ASSISTANT_BOT_USERNAME=@sizning_assistant_botingiz
SOURCE_BOT_USERNAMES=@UzcardBot,@HumoBot
